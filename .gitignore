# =========================================================================
# .gitignore kerostig (version fusionnee).
# Reprend les regles du projet d'origine callsforpapers ET les ajouts kerostig.
# Cette version est complete : tu peux remplacer le .gitignore existant par
# celle-ci sans rien perdre.
# =========================================================================

# --- Regles du projet d'origine, a conserver ---
node_modules/
public/
!www/public/
.vscode/
# Couvre .env, .env.local et toute copie de travail (.env.sauvegarde, .env.old...)
# qu'un simple motif .env laisserait passer. Le gabarit reste versionne.
.env*
!.env.exemple

# --- Ajouts kerostig ---
.cache-enrichissement/
.browser-profile/
.DS_Store
Thumbs.db

# Fichiers de travail temporaires (HTML sauvegardés pour Claude Code)
*.debug.html
emerald-page.html
tf-page.html
tf-hub.html
wiley-page.html
elsevier-hub.html
informs-page.html
aom-page.html
# Liste de titres T&F produite en cours de mise au point. Ramassee une fois
# par le git add -A du workflow de scraping, d'ou cette regle.
tf_titles.json
# Sortie complete de `npm run scrape` capturee a la racine lors des audits de
# pipeline (resserrement des dates, 2026-08-23). Meme raison que ci-dessus :
# sans cette regle, le git add -A du workflow la committerait au premier run.
scrape-audit.log
_tmp/
enrichissement/*
!enrichissement/*.py
!enrichissement/*.mjs
# Table de corrections ISSN + fusions FNEGE connues : quelques entrees
# curees a la main, pas un export du classement FNEGE, donc pas concernee par
# la regle "pas de liste FNEGE integrale". Lue a la fois par corrections_issn.py
# et par les scripts Node (reenrichir-issn-corriges.mjs, appliquer-conflits-rang.mjs) :
# doit rester versionnee pour que les deux cotes du pipeline restent en phase.
!enrichissement/corrections-issn.json
# Table des redirections de fiches fusionnees (301, lue par
# scripts/generer-redirects.mjs) : versionnee pour le meme motif que
# corrections-issn.json ci-dessus, chaque entree curee a la main.
!enrichissement/redirections.json
*.csv

# Fichiers supplementaires a ignorer
.gitignore-old
CLAUDE.md
elsevier-page-b.html
elsevier-page-c.html
elsevier-page.html
tf-hub-economics.html