---js
{
  pagination: {
    data: "journals",
    size: 1,
    alias: "revue",
    resolve: "values"
  },
  layout: "layouts/base.html",
  permalink: "journal/{{ revue.slug }}/",
  eleventyComputed: {
    title: "{{ revue.titre }} : rang FNEGE {{ revue.rang_fnege_2025 }}, accès ouvert et appels en cours",
    description: "{{ revue.titre }} en {{ revue.discipline }}. Rang FNEGE 2025 : {{ revue.rang_fnege_2025 }}. Appels à publications ouverts, accès ouvert et dépôt en archive ouverte."
  }
}
---

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Accueil", "item": "{{ meta.url }}" },
    { "@type": "ListItem", "position": 2, "name": "{{ revue.discipline }}", "item": "{{ meta.url }}discipline/{{ revue.discipline_code | slugify }}/" },
    { "@type": "ListItem", "position": 3, "name": "{{ revue.titre }}" }
  ]
}
</script>

<article class="max-w-3xl mx-auto">

<nav class="text-sm mb-6" aria-label="fil d'ariane">
  <span class="opacity-70"><a href="{{ '/' | url }}" class="hover:underline">Accueil</a>
  <span class="mx-1">/</span>
  {{ revue.discipline }}</span>
</nav>

<header class="mb-8">
  <h1 class="text-3xl md:text-4xl font-extrabold leading-tight mb-2">{{ revue.titre }}</h1>
  {% if revue.editeur %}<p class="text-sm opacity-80">{{ revue.editeur }}</p>{% endif %}

  <div class="flex flex-wrap gap-2 mt-3 text-xs">
    <span class="badge badge-outline font-semibold" style="color:#2B5F8E;border-color:#2B5F8E">rang FNEGE {{ revue.rang_fnege_2025 }}</span>
    <span class="badge badge-outline">{{ revue.discipline }}</span>
    {% if revue.acces_ouvert.est_oa %}
    <span class="badge badge-outline font-semibold" style="color:#2F7D5C;border-color:#2F7D5C">accès ouvert</span>
    {% endif %}
  </div>

  <p class="text-xs opacity-70 mt-2">
    ISSN{% if revue.pissn %} papier {{ revue.pissn }}{% endif %}{% if revue.eissn %} · en ligne {{ revue.eissn }}{% endif %}
  </p>
</header>

</article>

<section class="card bg-base-200 border border-base-300 rounded-lg mb-8">
  <div class="card-body p-5 gap-0">
    <h2 class="text-lg font-bold mb-4">En bref</h2>

    <dl class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-4 text-sm">

      <div>
        <dt class="opacity-70">Rang FNEGE 2025</dt>
        <dd class="font-bold text-xl">{{ revue.rang_fnege_2025 }}</dd>
      </div>

      <div>
        <dt class="opacity-70">Accès</dt>
        <dd class="font-semibold">
          {% if revue.acces_ouvert.est_oa %}
            <span style="color:#2F7D5C">Accès ouvert</span>
            {% if revue.acces_ouvert.apc %}
              {% if revue.acces_ouvert.apc.gratuit %}
                <br><span class="font-normal text-xs opacity-80">Sans frais de publication</span>
              {% else %}
                <br><span class="font-normal text-xs opacity-80">APC {{ revue.acces_ouvert.apc.montant }} {{ revue.acces_ouvert.apc.devise }}</span>
              {% endif %}
            {% endif %}
          {% else %}
            Sur abonnement
            {% if revue.acces_ouvert.apc and not revue.acces_ouvert.apc.gratuit %}
              <br><span class="font-normal text-xs opacity-80">Option hybride · APC {{ revue.acces_ouvert.apc.montant }} {{ revue.acces_ouvert.apc.devise }}</span>
            {% endif %}
          {% endif %}
          {% if revue.acces_ouvert.licence %}
            <br><span class="font-normal text-xs opacity-70">{{ revue.acces_ouvert.licence }}</span>
          {% endif %}
        </dd>
      </div>

      <div>
        <dt class="opacity-70">Discipline</dt>
        <dd class="font-semibold">{{ revue.discipline }}</dd>
      </div>

      <div>
        <dt class="opacity-70">Dépôt en archive ouverte</dt>
        <dd class="font-semibold">
          {% if revue.auto_archivage and revue.auto_archivage.found %}
            {% if revue.auto_archivage.depot_hal_possible %}<span style="color:#2F7D5C">Possible</span>{% else %}Sous conditions{% endif %}
            {% if revue.auto_archivage.version_deposable %}
              {% set version = revue.auto_archivage.version_deposable %}
              <br><span class="font-normal text-xs opacity-80">{% if version == 'published' %}Version éditeur{% elif version == 'accepted' %}Manuscrit accepté{% elif version == 'submitted' %}Manuscrit soumis{% else %}Version {{ version }}{% endif %}</span>
            {% endif %}
            {% if revue.auto_archivage.embargo_mois != null %}
              <br><span class="font-normal text-xs opacity-80">{% if revue.auto_archivage.embargo_mois > 0 %}Embargo {{ revue.auto_archivage.embargo_mois }} mois{% else %}Sans embargo{% endif %}</span>
            {% endif %}
            {% if revue.auto_archivage.avec_frais_additionnels %}
              <br><span class="font-normal text-xs opacity-80">Frais supplémentaires demandés</span>
            {% endif %}
          {% else %}
            Non renseignée
            <br><a href="https://openpolicyfinder.jisc.ac.uk/search" target="_blank" rel="noopener" class="font-normal text-xs underline opacity-80">Vérifier sur Open Policy Finder</a>
          {% endif %}
        </dd>
      </div>

    </dl>

    {% if revue.acces_ouvert.type_relecture %}
    <p class="text-xs opacity-70 mt-3">Relecture : {{ revue.acces_ouvert.type_relecture }}</p>
    {% endif %}

    {% if revue.metriques and revue.metriques.found %}
    <div class="border-t border-base-300 mt-5 pt-5">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-center">
        {% if revue.metriques.h_index != null %}
        <div class="bg-base-100 rounded-lg p-4"><div class="text-2xl font-bold">{{ revue.metriques.h_index }}</div><div class="text-xs opacity-70">h-index</div></div>
        {% endif %}
        {% if revue.metriques.citedness_2ans != null %}
        <div class="bg-base-100 rounded-lg p-4"><div class="text-2xl font-bold">{{ revue.metriques.citedness_2ans | round(1) }}</div><div class="text-xs opacity-70">citations / article (2 ans)</div></div>
        {% endif %}
        {% if revue.metriques.volume_annuel != null %}
        <div class="bg-base-100 rounded-lg p-4"><div class="text-2xl font-bold">{{ revue.metriques.volume_annuel }}</div><div class="text-xs opacity-70">articles en {{ revue.metriques.annee_volume }}</div></div>
        {% endif %}
      </div>
      {% if revue.metriques.thematiques and revue.metriques.thematiques.length %}
      <div class="flex flex-wrap gap-2 mt-4">
        {% for t in revue.metriques.thematiques %}<a href="{{ '/' | url }}?q={{ t | urlencode }}" class="badge badge-sm bg-base-100 border-0 opacity-80 hover:opacity-100 cursor-pointer">{{ t }}</a>{% endfor %}
      </div>
      {% endif %}
      <p class="text-xs opacity-70 mt-3 text-right">Source : OpenAlex</p>
    </div>
    {% endif %}

  </div>
</section>

<article class="max-w-3xl mx-auto">

{% set appels = calls | appelsDeLaRevue(revue) %}
<section class="mb-4">
  <div class="flex items-center justify-between mb-3">
    <h2 class="text-lg font-bold">Appels à publications ouverts</h2>
    <a href="{{ '/rss.xml' | url }}" class="text-xs opacity-70 hover:underline">Flux RSS global</a>
  </div>
  {% if appels.length %}
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    {% for call in appels %}
    {% set dueDate = call.dates | echeancePrincipale %}
    <div class="card bg-base-200 border border-base-300 rounded-lg">
      <div class="card-body p-4">
        <a href="{{ ('/call/' + call.slug) | url }}"><h3 class="card-title text-base">{{ call.title | safe }}</h3></a>
        {% if dueDate %}<p class="text-xs font-medium" style="color:#C15A34">Échéance {{ dueDate.date | dateOnly }}</p>{% endif %}
      </div>
    </div>
    {% endfor %}
  </div>
  {% else %}
  <div class="card bg-base-200 border border-base-300 rounded-lg">
    <div class="card-body p-5 text-center">
      <p class="text-sm opacity-70 mb-3">Aucun appel ouvert pour cette revue en ce moment. Les appels apparaîtront ici dès qu'ils seront collectés.</p>
      <a href="{{ '/' | url }}" class="btn btn-sm btn-primary">Consulter tous les appels ouverts</a>
    </div>
  </div>
  {% endif %}
</section>

<p class="text-xs opacity-70 mt-6 border-t border-base-300 pt-4">
  Rang et discipline : classement FNEGE 2025. Indicateurs : OpenAlex. Accès ouvert : DOAJ. Politique de dépôt : Open Policy Finder.
  Les données peuvent comporter des imprécisions, vérifiez toujours sur le site de la revue.
</p>

</article>
