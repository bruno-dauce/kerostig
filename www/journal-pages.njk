---js
{
  pagination: {
    data: "journals",
    size: 1,
    alias: "revue",
    resolve: "values"
  },
  layout: "layouts/base.html",
  permalink: "journal/{{ revue.slug }}/",
  eleventyComputed: {
    title: "{{ revue.titre }} : rang FNEGE {{ revue.rang_fnege_2025 }}, accès ouvert et appels en cours",
    description: "{{ revue.titre }} en {{ revue.discipline }}. Rang FNEGE 2025 : {{ revue.rang_fnege_2025 }}. Appels à publications ouverts, accès ouvert et dépôt en archive ouverte."
  }
}
---

<nav class="text-sm opacity-70 mb-6" aria-label="fil d'ariane">
  <a href="{{ '/' | url }}" class="hover:underline">accueil</a>
  <span class="mx-2">/</span>
  <span>{{ revue.discipline }}</span>
</nav>

<header class="mb-8">
  <h1 class="text-3xl md:text-4xl font-extrabold leading-tight mb-2">{{ revue.titre }}</h1>
  {% if revue.editeur %}<p class="text-sm opacity-70">{{ revue.editeur }}</p>{% endif %}

  <div class="flex flex-wrap gap-2 mt-3 text-xs">
    <span class="badge badge-outline">rang FNEGE {{ revue.rang_fnege_2025 }}</span>
    <span class="badge badge-outline">{{ revue.discipline }}</span>
    {% if revue.acces_ouvert.est_oa %}
    <span class="badge badge-outline" style="color:#2F7D5C;border-color:#2F7D5C">accès ouvert</span>
    {% endif %}
  </div>

  <p class="text-xs opacity-60 mt-2">
    ISSN{% if revue.pissn %} papier {{ revue.pissn }}{% endif %}{% if revue.eissn %} · en ligne {{ revue.eissn }}{% endif %}
  </p>
</header>

<section class="card bg-base-200 border border-neutral mb-8">
  <div class="card-body p-5 gap-4">
    <h2 class="text-lg font-bold">en bref</h2>
    <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-3 text-sm">

      <div>
        <dt class="opacity-60">rang FNEGE 2025</dt>
        <dd class="font-semibold">{{ revue.rang_fnege_2025 }}</dd>
      </div>

      <div>
        <dt class="opacity-60">discipline</dt>
        <dd class="font-semibold">{{ revue.discipline }}</dd>
      </div>

      <div>
        <dt class="opacity-60">accès</dt>
        <dd class="font-semibold">
          {% if revue.acces_ouvert.est_oa %}
          <span style="color:#2F7D5C">accès ouvert</span>{% if revue.acces_ouvert.apc %}{% if revue.acces_ouvert.apc.gratuit %} · sans frais de publication{% else %} · APC {{ revue.acces_ouvert.apc.montant }} {{ revue.acces_ouvert.apc.devise }}{% endif %}{% endif %}
          {% else %}
          sur abonnement
          {% endif %}
        </dd>
      </div>

      {% if revue.acces_ouvert.licence %}
      <div>
        <dt class="opacity-60">licence</dt>
        <dd class="font-semibold">{{ revue.acces_ouvert.licence }}</dd>
      </div>
      {% endif %}

      <div>
        <dt class="opacity-60">dépôt en archive ouverte</dt>
        <dd class="font-semibold">
          {% if revue.auto_archivage and revue.auto_archivage.found %}
          {% if revue.auto_archivage.depot_hal_possible %}<span style="color:#2F7D5C">possible</span>{% else %}possible sous conditions{% endif %}{% if revue.auto_archivage.version_deposable %} · version {{ revue.auto_archivage.version_deposable }}{% endif %}{% if revue.auto_archivage.embargo_mois %} · embargo {{ revue.auto_archivage.embargo_mois }} mois{% endif %}
          {% else %}
          politique non renseignée
          {% endif %}
        </dd>
      </div>

      {% if revue.acces_ouvert.type_relecture %}
      <div>
        <dt class="opacity-60">relecture</dt>
        <dd class="font-semibold">{{ revue.acces_ouvert.type_relecture }}</dd>
      </div>
      {% endif %}

    </dl>
  </div>
</section>

{% if revue.metriques and revue.metriques.found %}
<section class="mb-8">
  <h2 class="text-lg font-bold mb-3">indicateurs <span class="text-xs font-normal opacity-60">source OpenAlex</span></h2>
  <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 text-center">
    {% if revue.metriques.h_index != null %}
    <div class="card bg-base-200 border border-neutral"><div class="card-body p-3"><div class="text-2xl font-bold">{{ revue.metriques.h_index }}</div><div class="text-xs opacity-60">h-index</div></div></div>
    {% endif %}
    {% if revue.metriques.citedness_2ans != null %}
    <div class="card bg-base-200 border border-neutral"><div class="card-body p-3"><div class="text-2xl font-bold">{{ revue.metriques.citedness_2ans }}</div><div class="text-xs opacity-60">citations / article (2 ans)</div></div></div>
    {% endif %}
    {% if revue.metriques.volume_annuel != null %}
    <div class="card bg-base-200 border border-neutral"><div class="card-body p-3"><div class="text-2xl font-bold">{{ revue.metriques.volume_annuel }}</div><div class="text-xs opacity-60">articles en {{ revue.metriques.annee_volume }}</div></div></div>
    {% endif %}
  </div>
  {% if revue.metriques.thematiques and revue.metriques.thematiques.length %}
  <div class="flex flex-wrap gap-2 mt-4 text-xs">
    {% for t in revue.metriques.thematiques %}<span class="badge badge-outline">{{ t }}</span>{% endfor %}
  </div>
  {% endif %}
</section>
{% endif %}

{% set appels = calls | appelsDeLaRevue(revue) %}
<section class="mb-8">
  <div class="flex items-center justify-between mb-3">
    <h2 class="text-lg font-bold">appels à publications ouverts</h2>
    <a href="{{ '/rss.xml' | url }}" class="text-xs opacity-70 hover:underline">flux RSS</a>
  </div>
  {% if appels.length %}
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    {% for call in appels %}
    {% set dueDate = call.dates | echeancePrincipale %}
    <div class="card bg-base-200 border border-neutral">
      <div class="card-body p-4">
        <a href="{{ ('/call/' + call.slug) | url }}"><h3 class="card-title text-base">{{ call.title | safe }}</h3></a>
        {% if dueDate %}<p class="text-xs" style="color:#C15A34">échéance {{ dueDate.date | dateOnly }}</p>{% endif %}
      </div>
    </div>
    {% endfor %}
  </div>
  {% else %}
  <p class="text-sm opacity-60">aucun appel ouvert pour cette revue en ce moment. les appels apparaîtront ici automatiquement dès qu'ils seront collectés.</p>
  {% endif %}
</section>

<p class="text-xs opacity-50 mt-8 border-t border-neutral pt-4">
  rang et discipline : classement FNEGE 2025 · indicateurs : OpenAlex · accès ouvert : DOAJ · politique de dépôt : Sherpa Romeo.
  les données peuvent comporter des imprécisions, vérifiez toujours sur le site de la revue.
</p>
