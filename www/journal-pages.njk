---js
{
  pagination: {
    data: "journals",
    size: 1,
    alias: "revue",
    resolve: "values",
    // Sans ce drapeau, seule la premiere des 492 pages entrerait dans
    // collections.all, donc dans sitemap.xml (cf discipline-pages.njk).
    addAllPagesToCollections: true
  },
  layout: "layouts/base.html",
  permalink: "journal/{{ revue.slug }}/",
  // | safe : sans lui, l'esperluette des titres du type « Information &
  // Management » serait echappee ici puis une seconde fois par meta.html au
  // moment d'ecrire l'attribut. meta.html reste le seul point d'echappement.
  eleventyComputed: {
    title: "{{ revue.titre | safe }}, rang FNEGE {{ (revue | rangsFnege) | join(' et ') }}, appels à publications et accès ouvert",
    // Gabarit de la strategie SEO (section 4), cf scrapers/ficheRevue.mjs : acces,
    // depot HAL et presence d'appels ouverts ou archives y figurent, chacun omis
    // quand la donnee manque. Le titre porte « appels à publications », la
    // description « calls for papers » (strategie v2, section 4).
    description: "{{ revue | descriptionMetaRevue(calls) | safe }}"
  }
}
---

{% import "fnege.html" as fnege %}
{% import "source-oa.html" as srcOa %}
{% import "source-editeur.html" as srcEditeur %}

{# Fil d'Ariane + la revue en Periodical de plein droit (name, issn, publisher).
   Graphe assemble par le filtre schemaRevue, cf eleventy.config.mjs. #}
<script type="application/ld+json">
{{ revue | schemaRevue(meta) | jsonld | safe }}
</script>

<article class="max-w-3xl mx-auto">

{# Nom et slug de la discipline viennent de disciplines.json via le code FNEGE :
   le champ revue.discipline est un libelle brut, parfois sans apostrophe. #}
{% set disc = revue.discipline_code | disciplineDuCode %}

<nav class="text-sm mb-6" aria-label="fil d'ariane">
  <span class="opacity-70"><a href="{{ '/' | url }}" class="hover:underline">Accueil</a>
  <span class="mx-1">/</span>
  {% if disc %}<a href="{{ ('/discipline/' + disc.slug + '/') | url }}" class="hover:underline">{{ disc.nom }}</a>{% else %}{{ revue.discipline }}{% endif %}</span>
</nav>

<header class="mb-8">
  <h1 class="text-3xl md:text-4xl font-extrabold leading-tight mb-2">{{ revue.titre }}</h1>
  {% if revue.editeur %}<p class="text-sm opacity-80">{{ revue.editeur }} {{ srcEditeur.note() }}</p>{% else %}<p class="text-sm opacity-80">Éditeur : non renseigné</p>{% endif %}

  <div class="flex flex-wrap gap-2 mt-3 text-xs">
    {# Meme lien que les trois autres badges de rang du site (cf. call-card.html) :
       l'accueil pre-filtre sur ce rang. Pas de &disc ici, le contexte de page est
       une revue et non une discipline. Une revue en conflit FNEGE (deux lignes
       du classement, cf. corrections-issn.json) affiche un badge par rang plutot
       que d'en choisir un. #}
    {% for r in revue | rangsFnege %}
    <a href="{{ '/' | url }}?rang={{ r | urlencode }}"
       class="badge badge-outline font-semibold transition-colors hover:bg-primary/10"
       style="color:#2B5F8E;border-color:#2B5F8E">rang FNEGE {{ r }}</a>
    {% endfor %}
    {# Meme lien que le badge de discipline des cartes (cf. call-card.html). Le fil
       d'Ariane pointe deja vers la meme page : deux acces au meme endroit, comme le
       titre et « Voir l'appel » d'une carte. Repli en texte simple sans le code FNEGE,
       les pages /discipline/ ne sont generees que depuis disciplines.json. #}
    {% if disc %}
    <a href="{{ ('/discipline/' + disc.slug + '/') | url }}" class="badge badge-outline transition-colors hover:border-primary hover:text-primary">{{ disc.nom }}</a>
    {% else %}
    <span class="badge badge-outline">{{ revue.discipline }}</span>
    {% endif %}
    {% if revue.acces_ouvert.dans_doaj %}
    <span class="badge badge-outline font-semibold" style="color:#2F7D5C;border-color:#2F7D5C">accès ouvert</span>
    {% endif %}
  </div>

  {% if revue.rang_fnege_2025_note %}
  <p class="text-xs opacity-70 mt-2">{{ revue.rang_fnege_2025_note }}</p>
  {% endif %}

  <p class="text-xs opacity-70 mt-2">
    ISSN{% if revue.pissn %} papier {{ revue.pissn }}{% endif %}{% if revue.eissn %} · en ligne {{ revue.eissn }}{% endif %}
  </p>
</header>

</article>

<section class="card bg-base-200 border border-base-300 rounded-lg mb-8">
  <div class="card-body p-5 gap-0">
    <h2 class="text-lg font-bold mb-4">En bref</h2>

    <dl class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-4 text-sm">

      <div>
        {# Le renvoi vers la FNEGE se pose ici, sur l'intitule du rang, et non
           sur le badge de l'en-tete : celui-ci est deja un lien vers l'accueil
           pre-filtre, et un <a> ne peut pas en envelopper un autre. #}
        <dt class="opacity-70">Rang FNEGE 2025 ({{ fnege.texte() }})</dt>
        <dd class="font-bold text-xl">{{ (revue | rangsFnege) | join(' et ') }}</dd>
      </div>

      <div>
        <dt class="opacity-70">Accès</dt>
        <dd class="font-semibold">
          {# Seule la presence au DOAJ est un fait etabli. est_oa vient sinon de
             l'indicateur OpenAlex : il ne dit pas « sur abonnement » (revue hybride
             possible), on n'ecrit donc que la presence ou l'absence au DOAJ, et
             l'avis d'OpenAlex avec sa source quand il signale un acces ouvert. #}
          {% if revue.acces_ouvert.dans_doaj %}
            <span style="color:#2F7D5C">Accès ouvert (DOAJ)</span>
            {% if revue.acces_ouvert.apc %}
              {% if revue.acces_ouvert.apc.gratuit %}
                <br><span class="font-normal text-xs opacity-80">Sans frais de publication</span>
              {% else %}
                <br><span class="font-normal text-xs opacity-80">APC {{ revue.acces_ouvert.apc.montant }} {{ revue.acces_ouvert.apc.devise }}</span>
              {% endif %}
            {% endif %}
          {% else %}
            Non référencée au DOAJ
            {% if revue.acces_ouvert.est_oa %}
              <br><span class="font-normal text-xs opacity-80">Accès ouvert selon OpenAlex, non vérifié par DOAJ</span>
            {% endif %}
            {% if revue.acces_ouvert.apc and not revue.acces_ouvert.apc.gratuit %}
              <br><span class="font-normal text-xs opacity-80">APC {{ revue.acces_ouvert.apc.montant }} {{ revue.acces_ouvert.apc.devise }} (OpenAlex)</span>
            {% endif %}
          {% endif %}
          {% if revue.acces_ouvert.licence %}
            <br><span class="font-normal text-xs opacity-70">{{ revue.acces_ouvert.licence }}</span>
          {% endif %}
        </dd>
      </div>

      <div>
        <dt class="opacity-70">Discipline</dt>
        <dd class="font-semibold">
          {% if disc %}<a href="{{ ('/discipline/' + disc.slug + '/') | url }}" class="hover:underline">{{ disc.nom }}</a>{% else %}{{ revue.discipline }}{% endif %}
        </dd>
      </div>

      <div>
        <dt class="opacity-70">Dépôt en archive ouverte (HAL)</dt>
        <dd class="font-semibold">
          {% if revue.auto_archivage and revue.auto_archivage.found %}
            {# depot_hal_possible vaut true, false, ou null quand Open Policy Finder
               connait la revue sans detail exploitable : null n'est pas « sous
               conditions », on ne l'affirme pas. #}
            {% if revue.auto_archivage.depot_hal_possible == true %}<span style="color:#2F7D5C">Possible</span>{% elif revue.auto_archivage.depot_hal_possible == false %}Sous conditions{% else %}Non précisé{% endif %}
            {% if revue.auto_archivage.version_deposable %}
              {% set version = revue.auto_archivage.version_deposable %}
              <br><span class="font-normal text-xs opacity-80">{% if version == 'published' %}Version éditeur{% elif version == 'accepted' %}Manuscrit accepté{% elif version == 'submitted' %}Manuscrit soumis{% else %}Version {{ version }}{% endif %}</span>
            {% endif %}
            {% if revue.auto_archivage.embargo_mois != null %}
              <br><span class="font-normal text-xs opacity-80">{% if revue.auto_archivage.embargo_mois > 0 %}Embargo {{ revue.auto_archivage.embargo_mois }} mois{% else %}Sans embargo{% endif %}</span>
            {% endif %}
            {% if revue.auto_archivage.avec_frais_additionnels %}
              <br><span class="font-normal text-xs opacity-80">Frais supplémentaires demandés</span>
            {% endif %}
          {% else %}
            Non renseignée
            <br><a href="https://openpolicyfinder.jisc.ac.uk/search" target="_blank" rel="noopener" class="font-normal text-xs underline opacity-80">Vérifier sur Open Policy Finder</a>
          {% endif %}
          {# Hors du if/else : Mir@bel complete Open Policy Finder, il ne le
             remplace pas. Le lien vaut aussi bien pour une revue dont OPF
             connait la politique que pour une revue ou il n'a rien, et c'est
             surtout sur les titres francophones qu'il rend service. #}
          {% if revue.mirabel and revue.mirabel.trouve %}
            <br><a href="{{ revue.mirabel.url }}" target="_blank" rel="noopener" class="font-normal text-xs underline opacity-80">Voir dans Mir@bel</a>
          {% endif %}
        </dd>
      </div>

    </dl>

    {% if revue.acces_ouvert.type_relecture %}
    <p class="text-xs opacity-70 mt-3">Relecture : {{ revue.acces_ouvert.type_relecture }}</p>
    {% endif %}

    {% if revue.metriques and revue.metriques.found %}
    <div class="border-t border-base-300 mt-5 pt-5">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-center">
        {% if revue.metriques.h_index != null %}
        <div class="bg-base-100 rounded-lg p-4"><div class="text-2xl font-bold">{{ revue.metriques.h_index }}</div><div class="text-xs opacity-70">h-index</div></div>
        {% endif %}
        {% if revue.metriques.citedness_2ans != null %}
        <div class="bg-base-100 rounded-lg p-4"><div class="text-2xl font-bold">{{ revue.metriques.citedness_2ans | round(1) }}</div><div class="text-xs opacity-70">citations / article (2 ans)</div></div>
        {% endif %}
        {% if revue.metriques.volume_annuel != null %}
        <div class="bg-base-100 rounded-lg p-4"><div class="text-2xl font-bold">{{ revue.metriques.volume_annuel }}</div><div class="text-xs opacity-70">articles en {{ revue.metriques.annee_volume }}</div></div>
        {% endif %}
      </div>
      {% if revue.metriques.thematiques and revue.metriques.thematiques.length %}
      <div class="flex flex-wrap gap-2 mt-4">
        {% for t in revue.metriques.thematiques %}<a href="{{ '/' | url }}?q={{ t | urlencode }}" class="badge badge-sm bg-base-100 border-0 opacity-80 hover:opacity-100 cursor-pointer">{{ t }}</a>{% endfor %}
      </div>
      {% endif %}
      <p class="text-xs opacity-70 mt-3 text-right">Source : OpenAlex</p>
    </div>
    {% endif %}

  </div>
</section>

<article class="max-w-3xl mx-auto">

{% set appels = calls | appelsDeLaRevue(revue) %}
<section class="mb-4">
  <div class="flex items-center justify-between mb-3">
    <h2 class="text-lg font-bold">Appels à publications ouverts</h2>
    {# Le flux de la revue n'existe que pour une partie des revues (cf fluxRevuesDisponibles,
       eleventy.config.mjs) : sinon, repli sur le flux global. #}
    {% if revue.slug | fluxRevueExiste %}
    <a href="{{ ('/journal/' + revue.slug + '.xml') | url }}" class="text-xs opacity-70 hover:underline">Flux RSS de la revue</a>
    {% else %}
    <a href="{{ '/rss.xml' | url }}" class="text-xs opacity-70 hover:underline">Flux RSS global</a>
    {% endif %}
  </div>
  {% if appels.length %}
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    {% for call in appels %}
    {% set dueDate = call.dates | echeancePrincipale %}
    <div class="card bg-base-200 border border-base-300 rounded-lg">
      <div class="card-body p-4">
        {# Meme repli que call-card.html et call-pages.njk : un appel dont
           l'extraction n'a rien donne retombe sur le metaTitle du scraper,
           sans quoi le lien porte un libelle vide, donc incliquable. #}
        <a href="{{ ('/call/' + call.slug + '/') | url }}"><h3 class="card-title text-base">{{ call.title if call.title else call.metaTitle }}</h3></a>
        {% if dueDate %}<p class="text-xs font-medium" style="color:#C15A34">Échéance {{ dueDate.date | dateOnly }}</p>{% endif %}
      </div>
    </div>
    {% endfor %}
  </div>
  {% else %}
  <div class="card bg-base-200 border border-base-300 rounded-lg">
    <div class="card-body p-5 text-center">
      <p class="text-sm opacity-70 mb-3">Aucun appel ouvert pour cette revue en ce moment. Les appels apparaîtront ici dès qu'ils seront collectés. <a href="{{ ((('/journal/' + revue.slug + '.xml') if revue.slug | fluxRevueExiste else '/rss.xml')) | url }}" class="underline">{{ 'Flux RSS de la revue' if revue.slug | fluxRevueExiste else 'Flux RSS global' }}</a>.</p>
      <a href="{{ '/' | url }}" class="btn btn-sm btn-primary">Consulter tous les appels ouverts</a>
    </div>
  </div>
  {% endif %}
</section>

{# Appels clos : la fiche les listait nulle part, alors que leurs pages sont
   conservees en archive (cf. estAppelCloture). Section omise quand la revue n'en
   a aucun, sans phrase de remplissage. Le terracotta est reserve aux echeances
   a venir : celles-ci sont passees, elles restent neutres. #}
{% set archives = calls | appelsArchivesDeLaRevue(revue) %}
{% if archives.length %}
<section class="mb-8">
  <h2 class="text-lg font-bold mb-3">Appels archivés</h2>
  <ul class="divide-y divide-base-300 border-t border-base-300">
    {% for call in archives %}
    {% set dueDate = call.dates | echeancePrincipale %}
    <li class="py-2.5 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
      <a href="{{ ('/call/' + call.slug + '/') | url }}" class="text-sm hover:underline">{{ call.title if call.title else call.metaTitle }}</a>
      <span class="text-xs opacity-70 flex-shrink-0">{% if dueDate and dueDate.date %}clos le {{ dueDate.date | dateOnly }}{% else %}clos{% endif %}</span>
    </li>
    {% endfor %}
  </ul>
</section>
{% endif %}

{# Les revues voisines dans la liste de la discipline (rang puis titre) : une
   fenetre autour de celle-ci, cf. revuesVoisines. Sans discipline connue, rien. #}
{% set voisines = journals | revuesVoisines(revue) %}
{% if disc and voisines.length %}
<section class="mb-8">
  <h2 class="text-lg font-bold mb-3">Autres revues en {{ disc.nom }}</h2>
  <ul class="divide-y divide-base-300 border-t border-base-300">
    {% for v in voisines %}
    <li class="py-2.5 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
      <a href="{{ ('/journal/' + v.slug + '/') | url }}" class="text-sm hover:underline">{{ v.titre }}</a>
      <span class="flex flex-wrap items-center gap-1.5 flex-shrink-0">
        {% for r in v | rangsFnege %}
        <span class="badge badge-sm badge-outline font-semibold" style="color:#2B5F8E;border-color:#2B5F8E">FNEGE {{ r }}</span>
        {% endfor %}
      </span>
    </li>
    {% endfor %}
  </ul>
  <p class="text-sm mt-3">
    <a href="{{ ('/discipline/' + disc.slug + '/') | url }}" class="hover:underline" style="color:#2B5F8E">Toutes les revues et appels en {{ disc.nom }}</a>
  </p>
</section>
{% endif %}

<p class="text-xs opacity-70 mt-6 border-t border-base-300 pt-4">
  Rang et discipline : {{ fnege.texte('classement FNEGE 2025') }}. Indicateurs : OpenAlex. Accès ouvert : {{ srcOa.nom(revue) }}. Politique de dépôt : Open Policy Finder.{% if revue.mirabel and revue.mirabel.trouve %} Référencement : Mir@bel.{% endif %}
  Les données peuvent comporter des imprécisions, vérifiez toujours sur le site de la revue.
</p>

</article>
