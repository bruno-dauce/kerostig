---
pagination:
  data: calls
  size: 1
  alias: call
  addAllPagesToCollections: true
layout: layouts/base.html
permalink: "call/{{ call.slug }}/"
eleventyComputed:
  # Parentheses indispensables : sans elles, | safe ne portait que sur
  # call.metaTitle, jamais sur call.title. Un titre porteur d'une apostrophe
  # droite etait donc echappe ici (&#39;) puis une seconde fois par meta.html
  # (&amp;#39;). meta.html reste le seul point d'echappement.
  title: "kerostig | {{ (call.title if call.title else call.metaTitle) | safe }}"
  description: "kerostig rassemble les appels à publications en sciences de gestion et management, comme {{ (call.title if call.title else call.metaTitle) | safe }}, en un seul endroit."
---

{% set revue = journals | revueDeLAppel(call) %}
{% if call | estAppelCloture %}
{% set echeanceClose = call.dates | echeancePrincipale %}
{% set appelsOuvertsRevue = calls | appelsDeLaRevue(revue) if revue else [] %}
<aside class="border border-base-300 bg-base-200 rounded-lg p-4 mb-6">
  <p class="font-semibold" style="color:#C15A34">appel clôturé</p>
  <p class="text-sm opacity-80 mt-1">
    {% if echeanceClose and echeanceClose.date %}
    La date limite de soumission était le {{ echeanceClose.date | dateOnly }}.
    {% else %}
    Cet appel n'est plus ouvert aux soumissions.
    {% endif %}
    Cette page est conservée pour archive.
  </p>
  {% if revue %}
  <p class="text-sm mt-2">
    <a href="{{ ('/journal/' + revue.slug + '/') | url }}" class="font-semibold hover:underline" style="color:#2B5F8E">
      {% if appelsOuvertsRevue.length == 1 %}
      1 appel ouvert dans {{ revue.titre }}
      {% elif appelsOuvertsRevue.length %}
      {{ appelsOuvertsRevue.length }} appels ouverts dans {{ revue.titre }}
      {% else %}
      Voir la fiche de {{ revue.titre }}
      {% endif %}
    </a>
    {% if not appelsOuvertsRevue.length %}<span class="opacity-70"> — aucun appel ouvert pour cette revue en ce moment.</span>{% endif %}
  </p>
  {% endif %}
  <p class="text-sm mt-1">
    <a href="{{ '/' | url }}" class="hover:underline opacity-70">Tous les appels ouverts</a>
  </p>
</aside>
{% endif %}
{# Pas de | safe ici, contrairement au front matter ci-dessus : le titre est
   rendu dans le corps de la page, c'est donc ici qu'il doit etre echappe. Sans
   parentheses le filtre ne portait de toute facon que sur la branche de repli
   call.metaTitle, seule a sortir non echappee. #}
<h1 class="text-4xl font-extrabold leading-tight mb-3.5">{{ call.title if call.title else call.metaTitle }}</h1>
<div class="flex">
  <div>
    {% for tag in call.tags %}
    <a href="{{ ('/tag/' + (tag | slug) + '/') | url }}" class="badge badge-outline hover:bg-neutral-400">{{ tag }}</a>
    {% endfor %}
  </div>
</div>
<div class="flex justify-between items-center my-3.5">
  {# Pas de lien quand la jointure echoue, cf le meme garde-fou dans
     call-card.html : le repli sur call.journal | slug menait a une page
     /journal/ qui n'est jamais generee.
     TODO: a revoir avec la migration de la jointure appel-revue vers l'ISSN. #}
  {% if revue %}
  <a href="{{ ('/journal/' + revue.slug + '/') | url }}"><h2 class="text-2xl uppercase font-bold text-gray-600 hover:text-gray-500 leading-snug mt-4 mb-4">{{ call.journal }}</h2></a>
  {% else %}
  <h2 class="text-2xl uppercase font-bold text-gray-600 leading-snug mt-4 mb-4">{{ call.journal }}</h2>
  {% endif %}
  <a class="btn btn-primary" href="{{ call.url | url }}" target="_blank" rel="noopener noreferrer">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 11h2v5m-2 0h4m-2.592-8.5h.01M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/>
      </svg>
      Find out more
  </a>
</div>
<div class="flex flex-col lg:flex-row lg:items-start gap-8">
  {% if revue %}
  <div class="lg:order-2 lg:w-80 lg:flex-shrink-0">
    {% include "journal-info-card.html" %}
  </div>
  {% endif %}
  <div class="lg:order-1 flex-1 min-w-0">
    <div class="float-none md:float-end w-xs md:ms-8 mb-8">
      {% include "timeline.html" %}
    </div>
    {% if call.editors | length > 0 %}
    <h2 class="text-2xl font-bold leading-snug mt-8 mb-4">Editors</h2>
    <ul>
      {% for editor in call.editors %}
      <li><strong>{{ editor.name }}</strong>, {{ editor.affiliation }}</li>
      {% endfor %}
    </ul>
    {% endif %}
    {% if call.description and call.description.paragraphs | length > 0 %}
    <h2 class="text-2xl font-bold leading-snug mt-8 mb-4">Description</h2>
    {% for paragraph in call.description.paragraphs %}
    <p class="text-justify mb-4">{{ paragraph }}</p>
    {% endfor %}
    {% endif %}
    {% if call.topics | length > 0 %}
    <h2 class="text-2xl font-bold leading-snug mt-8 mb-4">Potential topics</h2>
    <ul class="list-disc ps-7">
      {% for topic in call.topics %}
      <li class="ps-1.5">{{ topic }}</li>
      {% endfor %}
    </ul>
    {% endif %}
    {% if call.associate_editors | length > 0 %}
    <h2 class="text-2xl font-bold leading-snug mt-8 mb-4">Associate editors</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
      {% for associate_editor in call.associate_editors %}
      <div class="w-fit"><strong>{{ associate_editor.name }}</strong>, {{ associate_editor.affiliation }}</div>
      {% endfor %}
    </div>
    {% endif %}
  </div>
</div>
{% include "jsond-schema.html" %}
