# Un robot n'obeit qu'a UN seul groupe : le plus specifique dont le nom
# correspond au sien, sans jamais fusionner avec le groupe *. Les bots d'IA
# nommes plus bas ne lisent donc pas les regles de ce groupe-ci et gardent
# l'acces a /data/.
#
# /data/ ne contient qu'un fichier, le flux public open-calls.json, annonce dans
# llms.txt. Il est ouvert a tous : la regle la plus longue l'emporte, donc
# Allow: /data/open-calls.json passe devant Disallow: /data/, qui ferme le reste
# du dossier si un fichier y etait ajoute un jour (on l'ecrit avant, pour les
# analyseurs qui retiennent la premiere regle correspondante : c'est aussi
# pourquoi le groupe * n'a plus de « Allow: / », inutile par defaut et qui, place
# en tete, rendait les Disallow inoperants pour ces analyseurs). Le flux ne porte
# pas le rang FNEGE : l'ouvrir ne republie pas la liste du classement.
#
# Les flux par tag (/tag/<slug>.xml) sont exclus : un flux par tag, c'est
# autant de documents qui reprennent le contenu des fiches d'appel sans rien
# y ajouter. Le joker vise bien les seuls flux -- les pages de tag, elles,
# sont servies en /tag/<slug>/ et restent explorables.
User-agent: *
Allow: /data/open-calls.json
Disallow: /data/
Disallow: /tag/*.xml

# Bots d'IA autorises explicitement, /data/ compris. Un jeton par groupe :
# chaque editeur en declare plusieurs, un par usage, et ils ne se deduisent pas
# les uns des autres. Autoriser GPTBot ne dit rien de OAI-SearchBot.

# OpenAI : entrainement, index de recherche ChatGPT, puis recuperation a la
# demande quand un utilisateur fait suivre un lien.
User-agent: GPTBot
Allow: /

User-agent: OAI-SearchBot
Allow: /

User-agent: ChatGPT-User
Allow: /

# Anthropic : meme decoupage en trois usages.
User-agent: ClaudeBot
Allow: /

User-agent: Claude-SearchBot
Allow: /

User-agent: Claude-User
Allow: /

# Perplexity : index de recherche, puis recuperation a la demande.
User-agent: PerplexityBot
Allow: /

User-agent: Perplexity-User
Allow: /

# Google-Extended n'explore rien : ce jeton dit seulement a Google s'il peut
# utiliser le contenu deja indexe pour ses modeles. Sa presence ici vaut
# autorisation, et ne retire pas Googlebot du groupe * ci-dessus.
User-agent: Google-Extended
Allow: /
