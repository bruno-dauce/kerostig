# Renommer ce fichier en .env (a la racine du projet, a cote du script).
# Ne jamais le committer : ajouter la ligne .env au fichier .gitignore.

# Cle API Sherpa Romeo (requise pour l'auto-archivage).
# S'obtient gratuitement : creer un compte sur https://openpolicyfinder.jisc.ac.uk
# (ex-Sherpa Romeo), puis onglet Admin > votre cle API.
SHERPA_API_KEY=

# Email pour le pool poli d'OpenAlex (recommande, pas obligatoire).
# Juste votre adresse : OpenAlex vous sert alors plus vite et plus stablement.
OPENALEX_MAILTO=
