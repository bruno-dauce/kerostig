{
  "name": "calls-for-papers",
  "version": "0.1.0",
  "description": "Find calls for papers in one location.",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('public',{recursive:true,force:true})\"",
    "start": "concurrently -n eleventy,tailwind -c blue,magenta \"eleventy --serve\" \"tailwind -i www/public/css/tailwind.css -o public/public/css/style.css --watch\"",
    "build": "cross-env ELEVENTY_PRODUCTION=true eleventy && cross-env NODE_ENV=production tailwind -i www/public/css/tailwind.css -o public/public/css/style.css --minify",
    "scrape": "node --env-file .env ./scrapers/scraper.mjs",
    "rss": "node ./scrapers/feedgen.mjs",
    "test": "node --env-file .env ./scrapers/scraper.mjs",
    "test:unit": "cross-env OPENAI_API_KEY=cle-factice-tests node --test \"scrapers/**/*.test.mjs\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bruno-dauce/kerostig.git"
  },
  "keywords": [
    "calls-for-papers",
    "special-issues",
    "academia",
    "research",
    "science"
  ],
  "author": "Bruno Daucé",
  "bugs": {
    "url": "https://github.com/bruno-dauce/kerostig/issues"
  },
  "homepage": "https://kerostig.org",
  "type": "module",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "alpinejs": "^3.14.8",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "daisyui": "^4.12.23",
    "tailwindcss": "^3.4.17"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "chrono-node": "^2.7.7",
    "feed": "^4.2.2",
    "mammoth": "^1.9.0",
    "openai": "^4.79.1",
    "patchright": "^1.49.2",
    "pdfjs-dist": "^4.10.38",
    "slugify": "^1.6.6",
    "turndown": "^7.2.0",
    "zod": "^3.24.1"
  }
}
